{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial meme usage profiles v1",
  "description": "Shape contract only. Canonical labels are checked against usage-vocabulary.json; source hashes, IDs and review provenance are checked by usage_profiles.py. No factual or psychological certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "emotions",
        "intents",
        "situations",
        "targets",
        "registers",
        "risk_flags",
        "safety",
        "context",
        "avoid_when",
        "example",
        "review_note",
        "emotion_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "emotions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "intents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "situations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "registers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "safety": {
          "enum": [
            "standard",
            "caution",
            "avoid"
          ]
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "avoid_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "kind"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "kind": {
              "const": "editorial"
            }
          }
        },
        "review_note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "emotion_status": {
          "enum": [
            "annotated",
            "unknown",
            "not_applicable"
          ]
        },
        "retrieval_requirements": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "situations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "intents": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "emotion_status": {
                "const": "annotated"
              }
            }
          },
          "then": {
            "properties": {
              "emotions": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "emotions": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "source_sha",
        "review_status",
        "review_note",
        "usages"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "review_status": {
          "enum": [
            "draft",
            "reviewed"
          ]
        },
        "review_note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "usages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usage"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "properties": {
              "usages": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
